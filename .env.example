# ── Database (Supabase) ───────────────────────────────────────
# Supabase → pulsante «Connect» in alto nella dashboard → scheda «ORM»
# DATABASE_URL  = riga "transaction-mode pooler" (porta 6543) — per l'app
# DIRECT_URL    = riga "session-mode pooler" (porta 5432) — per creare le tabelle
DATABASE_URL=
DIRECT_URL=

# ── Sessioni (JWT) ────────────────────────────────────────────
# Stringa lunga e casuale, usata per firmare i cookie di sessione dell'admin.
APP_SECRET=

# ── Login social Preghiere (Supabase Auth) ────────────────────
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://TUO-PROGETTO.supabase.co
SUPABASE_ANON_KEY=la-chiave-anon-public
# Le stesse due con prefisso VITE_ (incorporate nel frontend al build)
VITE_SUPABASE_URL=https://TUO-PROGETTO.supabase.co
VITE_SUPABASE_ANON_KEY=la-chiave-anon-public

# ── Email notifica nuove richieste di preghiera (Resend) ──────
RESEND_API_KEY=
PRAYER_NOTIFY_EMAIL=luigifrancescasposi@gmail.com

# ── Amministratore / Direttore GA ─────────────────────────────
# Copia questo modello in .env e sostituisci gli xxx con i valori reali.
# Il nome utente dell'amministratore è il suo indirizzo email.
# NON caricare mai .env su GitHub e NON usare il prefisso VITE_.
# La password non deve essere inserita nel codice frontend.
ADMIN_EMAIL=xxx
ADMIN_PASSWORD=xxx
ADMIN_NAME=xxx
# Se ADMIN_EMAIL e ADMIN_PASSWORD sono entrambe valorizzate, al primo login
# il server crea/aggiorna l'account in admin_accounts usando un hash scrypt.
# La password deve avere almeno 8 caratteri. I valori xxx non sono accettati.
# Su Vercel imposta queste variabili come Sensitive per Production (e Preview
# soltanto se necessario). Non inserirle mai nel frontend o nel repository.
