# ── Database (Supabase) ───────────────────────────────────────
# Supabase → pulsante «Connect» in alto nella dashboard → scheda «ORM»
# DATABASE_URL  = riga "transaction-mode pooler" (porta 6543) — per l'app
# DIRECT_URL    = riga "session-mode pooler" (porta 5432) — per creare le tabelle
DATABASE_URL=
DIRECT_URL=

# ── Sessioni (JWT) ────────────────────────────────────────────
# Stringa lunga e casuale, usata per firmare i cookie di sessione dell'admin.
APP_SECRET=
